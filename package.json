{
    "name": "playlist-audio-downloader",
    "version": "1.0.0",
    "description": "Desktop application for downloading Spotify and YouTube playlists as audio files",
    "main": "src/main/index.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder",
        "build:win": "electron-builder --win",
        "build:mac": "electron-builder --mac",
        "build:linux": "electron-builder --linux",
        "build:portable": "electron-builder --win portable"
    },
    "keywords": [
        "spotify",
        "downloader",
        "music",
        "playlist"
    ],
    "author": "DevArqf",
    "license": "MIT",
    "devDependencies": {
        "electron": "^42.0.1",
        "electron-builder": "^26.8.1"
    },
    "dependencies": {
        "axios": "^1.6.2"
    },
    "build": {
        "appId": "com.devarqf.playlistaudiodownloader",
        "productName": "Playlist Audio Downloader",
        "directories": {
            "output": "dist"
        },
        "files": [
            "**/*",
            "!**/*.md",
            "!.gitignore",
            "!README.md"
        ],
        "win": {
            "target": "nsis",
            "icon": "resources/icons/icon.ico",
            "signingHashAlgorithms": [
                "sha256"
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        },
        "mac": {
            "target": "dmg",
            "icon": "resources/icons/icon.icns",
            "hardenedRuntime": false,
            "gatekeeperAssess": false
        },
        "linux": {
            "target": "AppImage",
            "icon": "resources/icons/icon.png",
            "category": "Audio"
        }
    }
}
